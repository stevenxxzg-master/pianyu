- content_for :body_classes, 'public-page-body'
- content_for :page_title, t('public_pages.examples.title')
- content_for :header_tags do
  = render partial: 'shared/og', locals: { description: t('public_pages.examples.description', site: public_brand_name) }

.public-page.public-page--examples
  .public-page__ambient
  .public-page__frame
    = render 'shared/public/header'

    %main.public-page__main
      %section.public-hero.public-hero--compact
        .public-hero__copy
          %p.public-kicker= t('public_pages.examples.eyebrow')
          %h1.public-title= t('public_pages.examples.heading', site: public_brand_name)
          %p.public-intro= t('public_pages.examples.description', site: public_brand_name)

      %section.public-section
        .public-section__header
          %p.public-section__eyebrow= t('public_pages.examples.grid_eyebrow')
          %h2.public-section__title= t('public_pages.examples.grid_title')
        .public-card-grid.public-card-grid--examples
          - t('public_pages.examples.scenarios').each do |scenario|
            %article.public-card.public-card--accent
              %div.public-card__icon= material_symbol(public_copy(scenario, :icon), whitespace: false)
              %h3= public_copy(scenario, :title)
              %p= public_copy(scenario, :text)

      %section.public-band
        %div
          %p.public-band__eyebrow= t('public_pages.examples.path_eyebrow')
          %h2.public-band__title= t('public_pages.examples.path_title')
          %p.public-band__body= t('public_pages.examples.path_body')
        .public-band__actions
          = link_to t('public_pages.shared.actions.read_help'), help_path, class: 'public-button public-button--ghost'
          = link_to public_sign_up_label, available_sign_up_path, class: 'public-button'

    = render 'shared/public/footer'
