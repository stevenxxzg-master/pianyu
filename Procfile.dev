web: env RAILS_ENV=development bundle exec puma -C config/puma.rb
sidekiq: env RAILS_ENV=development bundle exec sidekiq
stream: env PORT=${STREAMING_PORT:-4000} NODE_ENV=development bin/yarn workspace @mastodon/streaming start
vite: env NODE_ENV=development VITE_RUBY_PORT=${VITE_RUBY_PORT:-3036} bin/yarn dev
