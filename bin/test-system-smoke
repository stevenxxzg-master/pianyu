#!/usr/bin/env ruby
# frozen_string_literal: true

ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../Gemfile', __dir__)
ENV['RAILS_ENV'] = 'test'
ENV['LOCAL_DOMAIN'] = 'localhost:3000'
ENV['WEB_DOMAIN'] = ENV['LOCAL_DOMAIN']
ENV['LOCAL_HTTPS'] = 'false'

require 'rubygems'
require 'bundler/setup'

exec Gem.ruby, File.expand_path('rspec', __dir__), 'spec/system/smoke', '--tag', 'streaming', '--tag', 'js'
