#!/usr/bin/env ruby
# frozen_string_literal: true

ENV['BUNDLE_GEMFILE'] ||= File.expand_path('../Gemfile', __dir__)
ENV['RAILS_ENV'] = 'test'

require 'socket'

server = TCPServer.new('127.0.0.1', 0)
smoke_port = server.addr[1]
server.close

ENV['CAPYBARA_SERVER_PORT'] = smoke_port.to_s
local_domain = ENV.fetch('LOCAL_DOMAIN', "localhost:#{smoke_port}")
ENV['LOCAL_DOMAIN'] = local_domain
ENV['WEB_DOMAIN'] = ENV.fetch('WEB_DOMAIN', local_domain)
ENV['LOCAL_HTTPS'] = 'false'
ENV['CI'] = 'true'
ENV['VITE_RUBY_AUTO_BUILD'] = 'false'

require 'rubygems'
require 'bundler/setup'

vite_command = [Gem.ruby, File.expand_path('vite', __dir__), 'build', '--mode', 'test']
abort 'Failed to build test Vite assets for smoke coverage' unless system(*vite_command)

exec Gem.ruby, File.expand_path('rspec', __dir__), 'spec/system/smoke', '--tag', 'streaming', '--tag', 'js'
