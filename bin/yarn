#!/usr/bin/env ruby
require 'fileutils'

APP_ROOT = File.expand_path('..', __dir__)

def find_executable(*names)
  ENV.fetch('PATH').split(File::PATH_SEPARATOR)
    .reject { |dir| File.expand_path(dir) == __dir__ }
    .flat_map { |dir| names.map { |name| File.expand_path(name, dir) } }
    .find { |file| File.executable?(file) }
end

Dir.chdir(APP_ROOT) do
  yarn = find_executable('yarn', 'yarn.cmd', 'yarn.ps1')
  exec yarn, *ARGV if yarn

  corepack = find_executable('corepack', 'corepack.cmd', 'corepack.ps1')

  if corepack
    ENV['COREPACK_HOME'] ||= File.join(APP_ROOT, 'tmp', 'corepack')
    FileUtils.mkdir_p(ENV['COREPACK_HOME'])
    exec corepack, 'yarn', *ARGV
  end

  $stderr.puts 'Yarn executable was not detected in the system.'
  $stderr.puts 'Install Node.js 20+ with Corepack, or install Yarn 4.x directly.'
  exit 1
end
