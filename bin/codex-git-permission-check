#!/usr/bin/env sh

set -eu

if ! repo_root=$(git rev-parse --show-toplevel 2>/dev/null); then
  echo "FAIL: current directory is not inside a git repository." >&2
  exit 1
fi

cd "$repo_root"

git_common_dir_rel=$(git rev-parse --git-common-dir)
git_common_dir=$(cd "$git_common_dir_rel" && pwd)
head_sha=$(git rev-parse --short HEAD)
probe_ref="refs/heads/codex-sandbox-probe-$$"

cleanup() {
  git update-ref -d "$probe_ref" >/dev/null 2>&1 || true
}

trap cleanup EXIT HUP INT TERM

printf 'repo=%s\n' "$repo_root"
printf 'git_dir=%s\n' "$git_common_dir"
printf 'head=%s\n' "$head_sha"
printf 'probe=%s\n' "$probe_ref"

if probe_output=$(git update-ref "$probe_ref" HEAD 2>&1); then
  git update-ref -d "$probe_ref" >/dev/null 2>&1 || true
  trap - EXIT HUP INT TERM
  echo "OK: local git metadata writes are available for this repository."
  echo "Next: run 'git pull --ff-only' before editing to confirm fetch/auth also work."
  exit 0
fi

echo "FAIL: cannot write git metadata under $git_common_dir." >&2
echo "Required writable roots for unattended Codex sessions:" >&2
echo "- $repo_root" >&2
echo "- $git_common_dir" >&2
echo "Required git capabilities: pull, branch creation, commit, push." >&2
echo "Original git error:" >&2
echo "$probe_output" >&2
exit 1
