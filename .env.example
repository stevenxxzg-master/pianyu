# Copy this file to `.env` before running `bin/setup` or `bin/dev`.
# `bin/dev`/Foreman and the streaming service read `.env`, while Rails also
# loads `.env.development`. Keep shared local defaults here.

# Local site defaults
LOCAL_DOMAIN=localhost:3000
LOCAL_HTTPS=false

# Vite development server origin used by the browser in development.
VITE_DEV_SERVER_PUBLIC=localhost:3036

# Mail sender shown by the local letter opener setup.
SMTP_FROM_ADDRESS=notifications@localhost

# PostgreSQL
# These defaults match a typical native local install. Dev Containers override
# them to `db`/`postgres` automatically in `.devcontainer/compose.yaml`.
DB_HOST=localhost
DB_PORT=5432
# DB_USER=postgres
# DB_PASS=postgres
# DB_NAME=mastodon_development

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Elasticsearch (optional)
# Native development can leave search disabled. Dev Containers override this
# to `true` and point `ES_HOST` at the bundled `es` service.
ES_ENABLED=false
# ES_HOST=localhost
# ES_PORT=9200

# Translation service (optional)
# Uncomment when running the LibreTranslate sidecar locally.
# LIBRE_TRANSLATE_ENDPOINT=http://localhost:5000

# Active Record encryption
# These local-only defaults mirror `.env.development` so Rails and `bin/dev`
# boot with the same values after `cp .env.example .env`.
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=fkSxKD2bF396kdQbrP1EJ7WbU7ZgNokR
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=r0hvVmzBVsjxC7AMlwhOzmtc36ZCOS1E
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=PhdFyyfy5xJ7WVd2lWBpcPScRQHzRTNr
